# Copy to .env and replace every placeholder before starting the stack.
# .env is gitignored. Do not commit real passwords.

APP_NAME=ReturnFlow
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins. Never use *.
# Include your Docker web port when using: docker compose --profile full up -d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# Docker Compose (optional): docker compose --profile full up -d
WEB_PORT=8080
API_PORT=8000

POSTGRES_USER=returnflow
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=returnflow
POSTGRES_PORT=5432

# Must use the postgresql+asyncpg driver and the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://returnflow:replace-with-a-strong-password@localhost:5432/returnflow
DATABASE_ECHO=false

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# At least 32 characters. This signs access tokens. Never commit a real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Knowledge documents (Phase 4). Leave blank for repo-local data/knowledge (dev) or
# /var/lib/returnflow/knowledge in the full Docker stack.
KNOWLEDGE_STORAGE_PATH=
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760

# Leave blank for repo-local data/chroma (dev) or /var/lib/returnflow/chroma in Docker.
CHROMA_PERSIST_PATH=

# mock = fast CI and Docker demos; sentence_transformers = local embeddings (heavier image)
RAG_EMBEDDINGS_PROVIDER=mock
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.32
LLM_PROVIDER=mock
# Optional live policy chat / live_llm pytest — never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Production: set APP_ENV=production, DEBUG=false, strong JWT_SECRET (32+ chars),
# unique POSTGRES_PASSWORD, explicit CORS_ORIGINS, and LLM/RAG providers as required.
